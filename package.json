{
  "name": "onze-br-lendario-prag",
  "private": true,
  "version": "1.0.0",
  "description": "Onze BR Lendário PRAG — jogo de draft com lendas do futebol brasileiro e simulação do Brasileirão.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate": "CALIBRATE=1 vitest run src/engine/calibrate.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:modes": "node scripts/e2e-modes.mjs",
    "data:harvest": "node scripts/data/harvest.mjs",
    "data:enwiki": "node scripts/data/enwiki.mjs",
    "data:extract": "node scripts/data/extract.mjs",
    "data:photos": "node scripts/data/photos.mjs",
    "data:build": "node scripts/data/build.mjs",
    "data:csv": "node scripts/data/export-csv.mjs",
    "build:artifact": "tsc -b && vite build --mode single && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.7"
  }
}
